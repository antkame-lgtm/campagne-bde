# Configuration d'environnement pour la campagne BDE
STORAGE_ENGINE=json
ALLOWED_EMAIL_DOMAINS=univ.tgmaster.com
EMAIL_HASH_SALT=replace-with-a-random-secret-of-at-least-32-characters
IDEA_SUBMISSION_TOKEN_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# Optionnel : envoi réel d'emails par Resend en production
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Équipe BDE <noreply@univ.tgmaster.com>"

# Lien vers la communauté WhatsApp de campagne
NEXT_PUBLIC_WHATSAPP_LINK=https://chat.whatsapp.com/REMPLACER_PAR_LE_LIEN_DU_GROUPE

# Alertes privées Telegram (Boîte à idées)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Synchronisation privée Google Sheets (Boîte à idées via Webhook Apps Script)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

